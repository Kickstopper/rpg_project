--- !u!114 &2928785859448325339
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 218803898729009999}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec97eb61044b80a4dab241ff1944569f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Controller.RetroBootTerminal
  terminalText: {fileID: 8759917160398914848}
  scrollRect: {fileID: 481655552528418437}
  terminalCanvasGroup: {fileID: 4710852882735571566}
  charCreationManager: {fileID: 635673194}
  typeSpeed: 0.001
  lineDelay: 0.1
  cursorChar: _
  cursorBlinkRate: 0.1
  fadeDuration: 1
  skipFadeDuration: 0.3
  bootSequence:
  - text: '> [SYSTEM BOOT SEQUENCE INITIATED]

      CONNECTING TO SECURE SERVER
      ... CONNECTED.

'
    preDelay: 0
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 1024
  - text: "+-----------------------------------------------------+\n|     III   
      III   IIIIIII   III    II   IIIIII IIIIIIIII IIIIIIII IIIIIII            |
      \n|     IIII   III   III  III  IIII   II  III  II     II    III      II IIII           
      | \n|     IIII  IIII  III    II  IIIII  II III    I     II    III      II  
      II            | \n|     IIIII IIII  II      II II II  II III          II   
      III      II   II            | \n|     IIIII IIII III      II II II  II  IIIII      
      II    IIIIIIII II   II            | \n|     IIIIIII II III      II II III II  
      IIIIII     II    IIIIIIII IIIIIII            | \n|     III II  II  II     
      II II  IIIII       III    II    III      II  III            | \n|     III II 
      II  III     II II   IIII        II    II    III      II  III            | \n|    
      III     II  III   III  II   IIII III   III    II    III      II   III          
      | \n|     III     II   IIIIIII   II    III IIIIIIII     II    IIIIIIII II   
      III          | \n|     III     II    IIIIII   II     II  IIIIII      II   
      IIIIIIII II     II          | \n|                                                                                    
      | \n|                                      III                                 
      III       | \n|               IIIIIII   II    II   IIIIIIIIIIIIIIIIIIIIIIIII
      IIIIII     IIIIIII     | \n|               IIIIIIII  II    II  IIIIIIIIIIIIIIIIIIIIIIIIII
      IIIIIIII  IIIIIIII     | \n|               II    II  II    II  II         
      II    III      III   II III           | \n|               II   III  II    II 
      II          II    III      III   II III           | \n|               IIIIIIII 
      II    II  IIIIII      II    IIIIIIII III IIII  IIIIII       | \n|              
      IIIIIIII  II    II   IIIIIII    II    IIIIIIII IIIIIII    IIIIIII     | \n|              
      II    III II    II       III    II    III      IIIIII        IIII     | \n|              
      II    III II    II        II    II    III      III IIII        II     | \n|              
      II    III III   II  I     II    II    III      III  III II     II     | \n|              
      IIIIIIII  IIIIIIII  IIIIIIII    II    IIIIIIII III   IIIIIIIIIIII     | \n|              
      IIIIIII    IIIIII   IIIIIII     II    IIIIIIII III    II IIIIIII      | \n+-----------------------------------------------------+"
    preDelay: 0.5
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
  - text: "> \uD604 \uC2DC\uAC04\uBD80\uB85C \uADC0\uD558\uB294 \uCD08\uAD6D\uAC00\uC801
      \uB300\uB9C8\uBD80\uB300 \n> '\uBAAC\uC2A4\uD130\uBC84\uC2A4\uD130\uC988'\uC758
      \uC815\uC2DD \uB300\uC6D0\uC73C\uB85C \uC778\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n"
    preDelay: 0.5
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
  - text: "> \uC0AC\uC545\uD55C \uB9C8\uBB3C\uB4E4\uC744 \uC12C\uBA78\uD558\uACE0,
      \r\n> \uC138\uACC4\uC758 \uD3C9\uD654\uB97C \uD0C8\uD658\uD558\uC2ED\uC2DC\uC624.\n"
    preDelay: 0.5
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
  - text: "> \uB9E8\uBAB8\uC73C\uB85C \uAD50\uC804\uD558\uB294 \uAC83\uC740 \uC9C0\uADF9\uD788
      \uBE44\uD569\uB9AC\uC801\uC785\uB2C8\uB2E4.\r\n> \uC774\uC5D0 \uACE0\uB300
      \uAC15\uB9C8\uC220\uACFC \uCCA8\uB2E8 \uACFC\uD559\uC758 \uACB0\uD569, \r\n>
      \uB9C8\uBB3C \uC18C\uD658\uAE30 [PACT]\uC758 \uC811\uADFC \uAD8C\uD55C\uC744
      \uBD80\uC5EC\uD569\uB2C8\uB2E4.\n"
    preDelay: 0.5
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
  - text: "> \uB9C8\uBB3C\uC744 \uD1B5\uC81C\uD558\uC5EC \uB9C8\uBB3C\uC5D0 \uB300\uC751\uD558\uC2ED\uC2DC\uC624.\r\n>
      PACT \uC870\uC791 \uC219\uB828\uB3C4\uAC00 \uACE7 \uB2F9\uC2E0\uC758 \uC0DD\uC874\uC744
      \uACB0\uC815\uC9C0\uC744 \uAC83\uC785\uB2C8\uB2E4.\n"
    preDelay: 0.5
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
  - text: '> GOOD LUCK.

'
    preDelay: 1
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
  - text: '> Press any key to continue

'
    preDelay: 0
    isMemoryCheck: 0
    memoryStart: 0
    memoryEnd: 0
